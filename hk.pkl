import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"

min_hk_version = "1.55.0"

local linters = new Mapping<String, Step> {
  ["actionlint"] = (Builtins.actionlint) {
    check = new Command { argv = List("actionlint", "-shellcheck=", "{{files}}") }
  }
  ["case-conflict"] = Builtins.check_case_conflict
  ["merge-conflict"] = Builtins.check_merge_conflict
  ["mise"] = Builtins.mise
  ["private-key"] = Builtins.detect_private_key
  ["taplo"] = Builtins.taplo
  ["typescript"] = new Step {
    glob = List("**/*.ts", "tsconfig.json", "package.json", "bun.lock")
    check = new Command { argv = List("bun", "x", "--no-install", "tsc", "--noEmit") }
  }
  ["moonbit-check"] = new Step {
    glob = List("**/*.mbt", "**/moon.pkg", "moon.mod")
    check = new Command { argv = List("moon", "check", "--target", "native", "--deny-warn") }
  }
  ["moonbit"] = new Step {
    glob = List("**/*.mbt", "**/moon.pkg", "moon.mod")
    check = new Command { argv = List("moon", "fmt", "--check") }
    fix = new Command { argv = List("moon", "fmt") }
  }
}

hooks {
  ["pre-commit"] { fix = true; stash = "git"; steps = linters }
  ["check"] { steps = linters }
  ["fix"] { fix = true; steps = linters }
}
